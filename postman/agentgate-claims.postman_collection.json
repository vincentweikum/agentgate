    {
      "name": "Payments",
      "description": "Claim payments. Human-operated clients only.",
      "item": [
        {
          "name": "Issue a claim payment",
          "request": {
            "name": "Issue a claim payment",
            "description": {
              "content": "Issues a payment on an approved claim and marks it paid. Requires `payments:write`, which only human-operated applications hold. AI agents can propose payments through the agent gateway, but a human must approve them.",
