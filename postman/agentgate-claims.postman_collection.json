            "url": {
              "path": [
                "v2",
                "claims"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": true,
                  "description": {
                    "content": "Only return claims in this status. (This can only be one of open,under_review,approved,denied,paid,closed)",
                    "type": "text/plain"
                  },
                  "key": "status",
                  "value": "open"
                },
                {
                  "disabled": true,
                  "description": {
                    "content": "Only return claims for this policy.",
                    "type": "text/plain"
                  },
                  "key": "policy_id",
                  "value": "POL-100231"
                },
                {
                  "disabled": false,
                  "description": {
                    "content": "Page size (max 100).",
                    "type": "text/plain"
                  },
                  "key": "limit",
                  "value": "20"
                },
                {
                  "disabled": false,
                  "description": {
                    "content": "Number of items to skip.",
                    "type": "text/plain"
                  },
                  "key": "offset",
                  "value": "0"
                }
              ],
              "variable": []
