{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API catalog entry",
  "description": "One file per API in catalog/. Enforced by scripts/catalog.py (STD-CAT-01).",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_id", "name", "description", "owner", "lifecycle_status", "spec", "data_classification",
               "contains_pii", "versions", "dependencies", "consumers"],
  "properties": {
    "api_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
    "name": {"type": "string", "minLength": 3, "maxLength": 80},
    "description": {"type": "string", "minLength": 10, "maxLength": 500},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "contact"],
      "properties": {
        "team": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "contact": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"}
      }
    },
    "lifecycle_status": {"enum": ["design", "active", "deprecated", "retired"]},
    "spec": {"type": "string"},
    "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "contains_pii": {"type": "boolean"},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "status", "released_on"],
        "properties": {
          "version": {"type": "string", "pattern": "^v[0-9]+$"},
          "status": {"enum": ["design", "active", "deprecated", "retired"]},
          "released_on": {"type": "string", "format": "date"},
          "deprecated_on": {"type": "string", "format": "date"},
          "sunset_on": {"type": "string", "format": "date"},
          "successor": {"type": "string", "pattern": "^v[0-9]+$"}
        },
        "if": {"properties": {"status": {"const": "deprecated"}}},
        "then": {"required": ["deprecated_on", "sunset_on", "successor"]}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}},
    "consumers": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}},
    "tags": {"type": "array", "items": {"type": "string", "maxLength": 30}}
  }
}
