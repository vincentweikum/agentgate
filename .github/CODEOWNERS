/STANDARDS.md                     @YOUR-GITHUB-USERNAME
/.github/                         @YOUR-GITHUB-USERNAME
/scripts/                         @YOUR-GITHUB-USERNAME
/tests/test_governance.py         @YOUR-GITHUB-USERNAME

# Who can call the API with which scopes, and how tokens are checked
/config/clients.yaml              @YOUR-GITHUB-USERNAME
/app/auth.py                      @YOUR-GITHUB-USERNAME

# What AI agents can do, and the evals that prove the guardrails hold
/agent_gateway/                   @YOUR-GITHUB-USERNAME
/evals/                           @YOUR-GITHUB-USERNAME
